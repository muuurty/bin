#!/bin/bash

VARPATH="$1"
RANGE="$2"
NUM_RANGE_INPUTS=$(echo "$RANGE" | awk -F"," '{print NF}')
TIMES=""
X=""
MS_TIME=0

if [ $NUM_RANGE_INPUTS -eq 3 ]; then
    START=$( echo "$RANGE" | awk -F"," '{print $1}' )
    END=$( echo "$RANGE" | awk -F"," '{print $2}' )
    STEP=$( echo "$RANGE" | awk -F"," '{print $3}' )
elif [ $NUM_RANGE_INPUTS -eq 2 ]; then
    START=$( echo "$RANGE" | awk -F"," '{print $1}' )
    END=$( echo "$RANGE" | awk -F"," '{print $2}' )
    STEP=1
elif [ $NUM_RANGE_INPUTS -eq 1 ]; then
    START=0
    END=$( echo "$RANGE" | awk -F"," '{print $1}' )
    STEP=1
else
    echo "bad range input"
    exit 1
fi

EXPONENT=1
[[ echo "$STEP" | awk -F"." '{print NF}' -eq 2 ]] && echo "out out out"

echo "$EXPONENT"

