#!/bin/bash

if [ -f "./makefile" ]; then
    MAKEFILE="makefile"
elif [ -f "./Makefile" ]; then
    MAKEFILE="Makefile"
else
    echo "there is no makefile"
    exit 1
fi

TARGET=$(grep -i "target" ./$MAKEFILE | grep "=" | awk -F"=" '{print $2}' | xargs)

if [[ -z $TARGET ]]; then
    echo "there is no target in the makefile"
    exit 1
fi

cmd="./$TARGET"

while getopts 'r:t no c:' flag; do
  case "${flag}" in
    r)  cmd="$cmd ${OPTARG}" ;;
  esac
done

[[ $* == *-t* ]] && cmd="time $cmd"
[[ $* == *-no* ]] && cmd="$cmd >/dev/null"

[[ $* == *-c* ]] && clear

make && eval "$cmd"

